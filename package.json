{
  "name": "habit-pirates",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:single": "VITE_SINGLEFILE=1 vite build --mode single",
    "build:kampf": "vite build --mode kampf",
    "sim": "node --experimental-strip-types scripts/sim.ts",
    "fxcheck": "node --experimental-strip-types scripts/fx-check.ts",
    "motcheck": "node --experimental-strip-types scripts/motivation-check.ts",
    "assets": "python3 scripts/prepare_assets.py",
    "journey": "node --experimental-strip-types --import ./scripts/lib/loader.mjs scripts/journey.ts",
    "check:release": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
